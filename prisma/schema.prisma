generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusPedido {
  PENDENTE
  APROVADO
  RECUSADO
}

enum Visibilidade {
  PUBLICO
  AMIGOS
  PRIVADO
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  bio          String?
  /// só quem é writer publica. Conta nova entra sem, e pede acesso.
  writer       Boolean   @default(false)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  posts        Post[]
  sessions     Session[]
  comentarios  Comentario[]
  leituras     Leitura[]

  /// pessoas que este usuário liberou para ver seus posts de amigos
  liberacoes Acesso[] @relation("Liberou")
  /// pessoas que liberaram este usuário
  acessos    Acesso[] @relation("Recebeu")

  pedido   PedidoWriter?  @relation("PedidoDe")
  decisoes PedidoWriter[] @relation("PedidoDecididoPor")
}

/// Pedido de acesso de escrita. Qualquer writer decide o pedido de qualquer um
/// — não há administrador, é confiança em rede.
model PedidoWriter {
  id         String       @id @default(cuid())
  userId     String       @unique
  user       User         @relation("PedidoDe", fields: [userId], references: [id], onDelete: Cascade)
  motivo     String?
  status     StatusPedido @default(PENDENTE)
  /// quem decidiu fica registrado: aprovação tem dono, não é anônima
  decisorId  String?
  decisor    User?        @relation("PedidoDecididoPor", fields: [decisorId], references: [id], onDelete: SetNull)
  decididoEm DateTime?    @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

/// Liberação de acesso: `owner` deixa `friend` ler seus posts com visibilidade AMIGOS.
model Acesso {
  id        String   @id @default(cuid())
  ownerId   String
  friendId  String
  owner     User     @relation("Liberou", fields: [ownerId], references: [id], onDelete: Cascade)
  friend    User     @relation("Recebeu", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([ownerId, friendId])
  @@index([friendId])
}

model Post {
  id         String       @id @default(cuid())
  slug       String       @unique
  title      String
  body       String
  tags       String[]
  featured   Boolean      @default(false)
  visibility Visibilidade @default(PUBLICO)
  /// o autor pode fechar a conversa sem apagar o que já foi dito
  commentsOpen Boolean    @default(true)
  authorId   String
  author     User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)
  comentarios Comentario[]
  leituras    Leitura[]

  @@index([visibility, createdAt])
  @@index([authorId, createdAt])
  @@index([featured, createdAt])
  @@index([tags], type: Gin)
}

/// Comentário de um post. Uma resposta aponta pro comentário raiz via `parentId`
/// — a árvore tem no máximo dois níveis, de propósito.
model Comentario {
  id        String   @id @default(cuid())
  body      String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comentario?  @relation("Respostas", fields: [parentId], references: [id], onDelete: Cascade)
  respostas Comentario[] @relation("Respostas")
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

/// Marca de leitura: `user` já leu `post`. A linha só existe enquanto está
/// marcado, então desmarcar é apagar, e não há estado "lido = false" para
/// manter em dia. O par é único: marcar duas vezes não cria duas linhas.
model Leitura {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, postId])
  /// a listagem pergunta "o que este usuário já leu", nunca "quem leu este post"
  @@index([userId])
}
